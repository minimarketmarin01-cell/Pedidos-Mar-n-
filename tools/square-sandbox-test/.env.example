# Copiar este archivo a ".env" en la misma carpeta y completar con
# las credenciales de SANDBOX del dashboard de desarrollador Square
# (developer.squareup.com/apps -> tu app -> pestaña "Sandbox").
#
# NUNCA usar credenciales de produccion aca. Este script solo debe
# correr contra el entorno sandbox (connect.squareupsandbox.com).

SQUARE_ACCESS_TOKEN=EAAAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: si no se define, el script toma automaticamente la
# primera location que tenga la cuenta sandbox.
# SQUARE_LOCATION_ID=

# Opcional: version de la API de Square a usar.
# SQUARE_VERSION=2024-08-21
